# NoteDrift environment variables.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in the values.
# NoteDrift runs fully anonymous and local-first WITHOUT any of these — auth,
# cloud and billing simply stay hidden/disabled until the relevant vars are set.
#
# NEVER put a secret (Supabase SECRET / service-role key, Stripe secret/webhook
# key) in a NEXT_PUBLIC_* variable — those are inlined into the browser bundle.
# The secrets below are read ONLY by server code (route handlers) behind
# `server-only` modules, so they never reach the client. NEVER commit real values.
#
# ⚠️  TEST and LIVE Stripe credentials must NEVER be mixed. The billing mode is
#     explicit (STRIPE_BILLING_MODE) and fails CLOSED: a key that doesn't match
#     the mode, or live mode on a non-production/insecure origin, disables billing.

# --- Public site config -----------------------------------------------------
# Canonical production origin, used for absolute SEO/canonical URLs, the sitemap,
# robots, and (in live billing) Stripe redirect origins. Defaults to
# https://notedrift.com when unset, which is fine for local dev.
NEXT_PUBLIC_SITE_URL=

# --- Supabase (auth + cloud) — browser-safe public values -------------------
# Both are safe to ship to the client: the URL is public and the publishable key
# grants nothing on its own (access is governed by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
# Modern publishable key (starts with `sb_publishable_`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative for older projects (the JWT anon key). Only one of the two
# keys is needed; the publishable key is preferred.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (billing) — required only for Pro billing ----------
# The app runs Free/local-first without these.
#
# Supabase SECRET (service-role) key — used server-side by the Stripe webhook and
# checkout to write server-owned billing state (bypasses RLS). Server-only.
SUPABASE_SECRET_KEY=

# Explicit Stripe billing mode: "test" (default) or "live". NOT NEXT_PUBLIC_.
#   * local / development / staging  -> test  (with TEST Stripe credentials)
#   * production                     -> live  (with LIVE Stripe credentials,
#                                              NODE_ENV=production, and a secure
#                                              https NEXT_PUBLIC_SITE_URL)
STRIPE_BILLING_MODE=test

# Stripe secret key. MUST match STRIPE_BILLING_MODE:
#   test mode -> sk_test_… or rk_test_…   |   live mode -> sk_live_… or rk_live_…
STRIPE_SECRET_KEY=

# Approved recurring Price ids (or Product ids) for NoteDrift Pro, in the SAME
# Stripe mode as the key above. A wrong-mode price is refused.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Signing secret for the Stripe webhook endpoint (starts with whsec_).
#   * local:      from `stripe listen` (a CLI secret, test mode only)
#   * production: from the Stripe Dashboard webhook endpoint (a DIFFERENT secret)
STRIPE_WEBHOOK_SECRET=
