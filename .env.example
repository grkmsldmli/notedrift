# NoteDrift environment variables.
#
# Copy this file to `.env.local` (which is git-ignored) and fill in the values
# from your Supabase project's API settings. NoteDrift runs fully anonymous and
# local-first WITHOUT these — auth simply stays hidden until they are present.
#
# BOTH values below are browser-safe. The URL is public, and the publishable key
# is designed to be shipped to clients (it grants nothing on its own; access is
# governed by Row Level Security on the server).
#
# NEVER put a secret (Supabase SECRET / service-role key, Stripe secret/webhook
# key) in a NEXT_PUBLIC_* variable — those are inlined into the browser bundle.
# The secrets below are read ONLY by server code (route handlers) behind
# `server-only` modules, so they never reach the client.

# Production origin, used for absolute SEO/canonical URLs on /tools pages.
# Defaults to https://notedrift.com when unset (fine for local dev).
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_SUPABASE_URL=
# Modern publishable key (starts with `sb_publishable_`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alternative for older projects (the JWT anon key). Only one of the two
# keys is needed; the publishable key is preferred.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets (Phase 2.0D billing). Required only for Pro billing;
# --- the app runs Free/local-first without them. NEVER commit real values.
# Supabase SECRET (service-role) key — used server-side by the Stripe webhook and
# checkout to write server-owned billing state (bypasses RLS). Server-only.
SUPABASE_SECRET_KEY=
# Stripe SANDBOX/TEST secret key (starts with sk_test_ or rk_test_). The app
# refuses to run with a live key.
STRIPE_SECRET_KEY=
# Approved recurring Price ids for NoteDrift Pro (from the Stripe sandbox).
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Signing secret for the Stripe webhook endpoint (starts with whsec_). Obtain it
# from `stripe listen` (local) or the Stripe Dashboard webhook (deployed).
STRIPE_WEBHOOK_SECRET=
