# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (real values stay local; the template is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated PDF.js runtime assets (see scripts/copy-pdfjs-assets.mjs)
/public/pdfjs/

# temporary PDF test fixtures (regenerated during dev testing)
/public/__test/

# local-only launch artifacts (billing backups, secrets) — NEVER committed
/docs/launch/private-local/
# temporary local DB/verification scripts
/scratch-*.mjs
